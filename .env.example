
# Backend API URL - Must match the port your backend is running on
VITE_BACKEND_API_URL=http://localhost:3001

# Company Information
VITE_COMPANY_EMAIL=contact@snapsummary.com
VITE_COMPANY_NAME=SnapSummary

# Feature Flags
VITE_ENABLE_YOUTUBE_SUMMARIZER=true
VITE_ENABLE_AI_ASSISTANT=true

# OpenAI Configuration
# For direct API access without a backend, add your API key below
# WARNING: Exposing API keys in frontend code is not recommended for production
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_MODEL=gpt-4o

# NOTE: For production, consider using a backend to handle API calls securely
