
# Backend API URL
VITE_BACKEND_API_URL=http://localhost:8000

# Company Information
VITE_COMPANY_EMAIL=contact@snapsummary.com
VITE_COMPANY_NAME=SnapSummary

# Feature Flags
VITE_ENABLE_YOUTUBE_SUMMARIZER=true
VITE_ENABLE_AI_ASSISTANT=true

# OpenAI Configuration (required for direct API access)
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_MODEL=gpt-3.5-turbo
